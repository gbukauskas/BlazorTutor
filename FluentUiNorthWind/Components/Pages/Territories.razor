@page "/Territories/{action?}/{argument?}/{pagenumber:int?}/{errormessage?}"
@using ClassLibraryDatabase.DB_Context.Models
@using ClassLibraryDatabase.Services
@rendermode InteractiveServer

@inject TerritorySvc dbSVC

<FluentCard MinimalStyle="true">
    <FluentPaginator State="@pagination" SummaryTemplate="@template" />

    <FluentDataGrid @ref="grid"
            Items="@filteredTerritories" 
            Pagination="@pagination">
        <PropertyColumn Property="@(p => p.TerritoryId)" Sortable="true" />
        <PropertyColumn Property="@(p => p.TerritoryDescription)" Sortable="true" />
        <PropertyColumn Property="@(p => p.RegionId)" Sortable="true" />
        <PropertyColumn Property="@(p => p.RegionDescription)" Sortable="true" />
    </FluentDataGrid>

    <FluentPaginator State="@pagination" />
</FluentCard>

<HeadContent>
    <meta name="description" content="Territories">
</HeadContent>

@code {
    FluentDataGrid<TerritoryWithRegion>? grid;

    /// <summary>
    /// Action in the current page: read comments at beginnig of the file
    /// </summary>
    [Parameter]
    public string? Action { get; set; } = null;

    /// <summary>
    /// Page size or Sort definition
    /// </summary>
    [Parameter]
    public string? Argument { get; set; } = null;

    /// <summary>
    /// Current page
    /// </summary>
    [Parameter]
    public int? PageNumber { get; set; } = null;
    /// <summary>
    /// Error message
    /// </summary>
    [Parameter]
    public string ErrorMessage { get; set; } = "";

    [SupplyParameterFromQuery(Name = "db_error")]
    public string? DBerrorMessage { get; set; } = null;

    PaginationState pagination = new PaginationState() { ItemsPerPage = 20 };


    private IQueryable<TerritoryWithRegion>? filteredTerritories;

    
//  record Person(int PersonId, string Name, DateOnly BirthDate);
